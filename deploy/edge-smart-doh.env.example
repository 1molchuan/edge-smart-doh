# /etc/edge-smart-doh/env for the Node.js server (deploy/edge-smart-doh.service). Every variable is
# described in README.md; anything left out takes the default from server/node.ts.
HOST=127.0.0.1
PORT=8787
# Requests for any other Host are refused (421). Comma-separated.
PUBLIC_HOSTNAMES=doh.example.com
UPSTREAMS=https://cloudflare-dns.com/dns-query,https://dns.google/dns-query,https://unfiltered.adguard-dns.com/dns-query
# Queries that carry ECS (Chinese-site rules) go to resolvers that forward it: Chinese ones only.
# Cloudflare never forwards ECS, and Google, with the very same ECS, gets the overseas nodes of
# Baidu, Huawei, Ctrip and Qunar, so neither belongs here. Check that each one answers from your
# server: some hosting networks cannot reach 1.12.12.12 (DNSPod).
ECS_UPSTREAMS=https://dns.alidns.com/dns-query,https://1.12.12.12/dns-query
# Sites whose name servers answer by the resolver's location and ignore ECS: only the first
# ECS_UPSTREAMS entry answers them, so put first a resolver that looks names up from the mainland.
# From Hong Kong, DNSPod (1.12.12.12) does and AliDNS does not; CNKI then gives AliDNS its
# international site. Leave empty unless the first entry is such a resolver.
RESOLVER_VIEW_DOMAINS=
UPSTREAM_TIMEOUT_MS=2500
UPSTREAM_HEDGE_MS=50
# The ECS group's own hedge. 0: the next ECS upstream is asked only when one fails or times out, so
# the first one answers every query it can.
ECS_UPSTREAM_HEDGE_MS=0
CACHE_MIN_TTL=30
CACHE_MAX_TTL=3600
NEGATIVE_CACHE_MAX_TTL=300
CACHE_STALE_TTL=86400
CACHE_PREFETCH_PERCENT=10
CACHE_MAX_ENTRIES=8192
# In-memory DNS cache is dumped here on shutdown (and every 5 minutes) and reloaded on start.
CACHE_PERSIST_PATH=/var/lib/edge-smart-doh/cache.bin
ECS_MODE=rules
ECS_DOMAINS=.cn,.qq.com,.taobao.com,.tmall.com,.alicdn.com,.jd.com,.baidu.com,.bilibili.com,.hdslb.com,.douyin.com,.zhihu.com,.163.com,.weibo.com,.xiaohongshu.com
ECS_IPV4_PREFIX=24
ECS_IPV6_PREFIX=48
# Chinese-site list: every name on it is resolved like ECS_DOMAINS (domestic CDN answers).
ECS_DOMAIN_LIST_URLS=https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/direct-list.txt
# Clients outside every mainland operator get this subnet as ECS instead of their own, so Chinese
# sites still answer with a domestic node: LAN/loopback clients (127.0.0.1, 192.168.x.x) always
# qualify; public clients need ISP_TABLE_URL to be classified. A "/24" suffix is accepted.
ECS_FALLBACK_SUBNET=
# Domain-split module: domestic names (ECS_DOMAINS + CN_DOMAINS + the lists above) go to these
# direct domestic resolvers instead of the proxied trust list — no ECS, they see the client's own
# operator by source IP. Empty = off, domestic names use the ECS path instead. In proxied home
# deployments their hostnames must be in the service's NO_PROXY or they go through the proxy too.
CN_UPSTREAMS=
# Extra domestic suffixes on top of ECS_DOMAINS and the lists (your own additions).
CN_DOMAINS=

# Preferred IPs. With probers or a probe hub pushing pools, answers use those; otherwise the addresses
# of these community preferred domains (resolved and merged) are the pool. The rewrite switches itself
# on whenever a pool is available (learned, domains or CF_PREFERRED_IPV4/IPV6), so this can stay false.
CF_REWRITE_ENABLED=false
CF_PREFERRED_DOMAIN=cf.090227.xyz,skk.moe
CF_DROP_AAAA=false
# Names answered exactly as upstream gave them (subdomains included). Cloudflare tunnels and WARP
# (argotunnel.com, cftunnel.com, cloudflareclient.com) are always excluded.
CF_REWRITE_EXCLUDE=

# Admin API (probers push pools with it). Generate with: openssl rand -hex 32
ADMIN_TOKEN=__ADMIN_TOKEN__
# Optional, for a probe hub (github.com/1molchuan/cfhub): it may only write operator pools.
HUB_TOKEN=
# Optional: client IP -> operator table ("<isp> <cidr>" lines), served by the hub.
ISP_TABLE_URL=

ECH_ENABLED=true
ECH_SOURCE_DOMAIN=cloudflare-ech.com
# Seed ECHConfigList for Meta's sites (Meta publishes none in DNS); probers keep it fresh.
META_ECH_CONFIG_BASE64=AEj+DQBEAQAgACAdd+scUi0IYFsXnUIU7ko2Nd9+F8M26pAGZVpz/KrWPgAEAAEAAWQVZWNoLXB1YmxpYy5hdG1ldGEuY29tAAA=
META_DOMAINS=.facebook.com,.facebook.net,.fbcdn.net,.fbsbx.com,.instagram.com,.cdninstagram.com,.threads.net,.whatsapp.com,.whatsapp.net,.messenger.com
X_DOMAINS=x.com,.x.com,twitter.com,.twitter.com,twimg.com,.twimg.com,t.co
# GitHub hosts pinned to per-host pools measured by a prober (echprobe -github). Empty disables.
GITHUB_DOMAINS=github.com,gist.github.com,api.github.com,codeload.github.com,raw.githubusercontent.com,objects.githubusercontent.com,avatars.githubusercontent.com,github.githubassets.com
# SNI relay (home deployments only; see contrib/home/relay/DESIGN.md). The console (contrib/home/
# monitor) changes RELAY_MODE / RELAY_DOMAINS / RELAY_EXCLUDE_DOMAINS and the forced pool's
# RELAY_FORCED_MODE / RELAY_FORCED_DOMAINS at runtime via POST /admin/relay-config;
# RELAY_CONFIG_PATH persists those overrides across restarts (the service user owns
# /var/lib/edge-smart-doh). Empty = overrides are memory-only.
RELAY_MODE=off
RELAY_IP=
RELAY_DOMAINS=
RELAY_EXCLUDE_DOMAINS=
# LAN-only gate (default on): the relay answers a private address, so only clients whose source
# address is private (RFC1918 / RFC3927 / ULA / loopback) get it. A client off the LAN — or one whose
# address cannot be resolved — keeps the ordinary answer (preferred pool / upstream) instead of a LAN
# IP it can only time out on. On unless explicitly false/0/no/off; a missing or misspelled value still
# fails safe to on. Set false only where every client necessarily looks remote (e.g. a cloud worker).
RELAY_LAN_ONLY=true
# Forced pool — the second tier, separate from RELAY_DOMAINS (the GitHub family): names here have
# no measured pool (Google family), so auto could never judge them; only off/always, always pins
# them to the relay whenever the daemon reports healthy. Shares RELAY_IP/RELAY_EXCLUDE_DOMAINS.
RELAY_FORCED_MODE=off
RELAY_FORCED_DOMAINS=
RELAY_CONFIG_PATH=
# ?safe=1 ad and scam blocking: block lists (one domain per line, subdomains included) and never-block
# exceptions. Empty disables the feature. anti-AD targets Chinese ad SDKs; HaGeZi TIF mini is threat intel.
SAFE_LIST_URLS=https://anti-ad.net/domains.txt,https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/tif.mini-onlydomains.txt
SAFE_ALLOW=

RULES_JSON=[]
DYNAMIC_RULE_HOSTS=paste.rs,raw.githubusercontent.com,gist.githubusercontent.com
DYNAMIC_RULES_MAX_BYTES=262144
DEBUG=false
LOG_QUERIES=false
MAX_DNS_PACKET_SIZE=4096
