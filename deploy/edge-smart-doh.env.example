# /etc/edge-smart-doh/env for the Node.js server (deploy/edge-smart-doh.service). Every variable is
# described in README.md; anything left out takes the default from server/node.ts.
HOST=127.0.0.1
PORT=8787
# Requests for any other Host are refused (421). Comma-separated.
PUBLIC_HOSTNAMES=doh.example.com
UPSTREAMS=https://cloudflare-dns.com/dns-query,https://dns.google/dns-query,https://dns.quad9.net/dns-query
# Queries that carry ECS (Chinese-site rules) go to resolvers that forward it. Cloudflare never
# forwards ECS, so it is deliberately absent here.
ECS_UPSTREAMS=https://1.12.12.12/dns-query,https://dns.google/dns-query,https://dns.alidns.com/dns-query
UPSTREAM_TIMEOUT_MS=2500
UPSTREAM_HEDGE_MS=50
CACHE_MIN_TTL=30
CACHE_MAX_TTL=3600
NEGATIVE_CACHE_MAX_TTL=300
CACHE_STALE_TTL=86400
CACHE_PREFETCH_PERCENT=10
CACHE_MAX_ENTRIES=8192
# In-memory DNS cache is dumped here on shutdown (and every 5 minutes) and reloaded on start.
CACHE_PERSIST_PATH=/var/lib/edge-smart-doh/cache.bin
ECS_MODE=rules
ECS_DOMAINS=.cn,.qq.com,.taobao.com,.tmall.com,.alicdn.com,.jd.com,.baidu.com,.bilibili.com,.hdslb.com,.douyin.com,.zhihu.com,.163.com,.weibo.com,.xiaohongshu.com
ECS_IPV4_PREFIX=24
ECS_IPV6_PREFIX=48
# Chinese-site list: every name on it is resolved like ECS_DOMAINS (domestic CDN answers).
ECS_DOMAIN_LIST_URLS=https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/direct-list.txt
# Clients outside every mainland operator (DoH sent through a proxy) get this subnet as ECS instead of
# the proxy's, so Chinese sites still answer with a domestic node. Needs ISP_TABLE_URL.
ECS_FALLBACK_SUBNET=

# Preferred IPs. With probers or a probe hub pushing pools, answers use those; otherwise the addresses
# of these community preferred domains (resolved and merged) are the pool. The rewrite switches itself
# on whenever a pool is available (learned, domains or CF_PREFERRED_IPV4/IPV6), so this can stay false.
CF_REWRITE_ENABLED=false
CF_PREFERRED_DOMAIN=cf.090227.xyz,skk.moe
CF_DROP_AAAA=false

# Admin API (probers push pools with it). Generate with: openssl rand -hex 32
ADMIN_TOKEN=__ADMIN_TOKEN__
# Optional, for a probe hub (github.com/1molchuan/cfhub): it may only write operator pools.
HUB_TOKEN=
# Optional: client IP -> operator table ("<isp> <cidr>" lines), served by the hub.
ISP_TABLE_URL=

ECH_ENABLED=true
ECH_SOURCE_DOMAIN=cloudflare-ech.com
# Seed ECHConfigList for Meta's sites (Meta publishes none in DNS); probers keep it fresh.
META_ECH_CONFIG_BASE64=AEj+DQBEAQAgACAdd+scUi0IYFsXnUIU7ko2Nd9+F8M26pAGZVpz/KrWPgAEAAEAAWQVZWNoLXB1YmxpYy5hdG1ldGEuY29tAAA=
META_DOMAINS=.facebook.com,.facebook.net,.fbcdn.net,.fbsbx.com,.instagram.com,.cdninstagram.com,.threads.net,.whatsapp.com,.whatsapp.net,.messenger.com
X_DOMAINS=x.com,.x.com,twitter.com,.twitter.com,twimg.com,.twimg.com,t.co
# GitHub hosts pinned to per-host pools measured by a prober (echprobe -github). Empty disables.
GITHUB_DOMAINS=github.com,gist.github.com,api.github.com,codeload.github.com,raw.githubusercontent.com,objects.githubusercontent.com,avatars.githubusercontent.com,github.githubassets.com
# ?safe=1 ad and scam blocking: block lists (one domain per line, subdomains included) and never-block
# exceptions. Empty disables the feature. anti-AD targets Chinese ad SDKs; HaGeZi TIF mini is threat intel.
SAFE_LIST_URLS=https://anti-ad.net/domains.txt,https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/tif.mini-onlydomains.txt
SAFE_ALLOW=

RULES_JSON=[]
DYNAMIC_RULE_HOSTS=paste.rs,raw.githubusercontent.com,gist.githubusercontent.com
DYNAMIC_RULES_MAX_BYTES=262144
DEBUG=false
LOG_QUERIES=false
MAX_DNS_PACKET_SIZE=4096
