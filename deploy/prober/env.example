DOH_URL=https://edge.1molchuan.top/dns-query
# Only for boxes whose system DNS cannot resolve the DoH host: dial it at this IP instead. Leave
# empty otherwise; a pinned IP breaks every probe when the CDN moves the host (2026-09-30).
DOH_IP=
# Candidate domains are resolved through a plain DoH, never our own (which rewrites Cloudflare
# answers to the current pool). AliDNS by IP is fast from mainland China and returns full sets.
RESOLVE_DOH=https://223.5.5.5/dns-query
ADMIN_URL=https://edge.1molchuan.top/admin/preferred
# Same value as ADMIN_TOKEN in the DoH server env.
ECHPROBE_ADMIN_TOKEN=__ADMIN_TOKEN__
SOURCE=aliyun-shanghai
# Handshakes alternate between these hosts and must get 200 from /cdn-cgi/trace. Keep a
# non-Enterprise zone (linux.do) in the list: some Cloudflare IPs serve Enterprise zones like x.com
# but answer every other site with 403 (error 1034), which broke linux.do images when only x.com
# was tested.
RANK_TARGET=x.com,linux.do
# 12 back-to-back ECH handshakes per IP: at 4, throttled IPs that fail 1 in 3 still passed.
ROUNDS=12
# Community preferred-domain pools, then ordinary Cloudflare-proxied sites: each zone is handed its
# own pair of addresses, so more zones cover more /24s. All resolved to Cloudflare via AliDNS
# 2026-09-24 (dead pools like cf.zhetengsha.eu.org, bestcf.top dropped).
CANDIDATES=cf.090227.xyz,cmcc.090227.xyz,cu.090227.xyz,ct.090227.xyz,skk.moe,yx.cloudflare.182682.xyz,cfip.xxxxxxxx.tk,www.visa.com.hk,openai.com,cloudflare-ip.mofashi.ltd,saas.sin.fan,cf.877774.xyz,cf.0sm.com,cf.130519.xyz,ip.164746.xyz,www.visa.com.sg,www.visa.com.tw,icook.tw,icook.hk,japan.com,www.digitalocean.com,www.shopify.com,www.udemy.com,www.hugedomains.com,www.ipget.net,www.gov.ua
# IPs drawn per candidate domain each run (cmcc.090227.xyz alone returns ~50).
PER_DOMAIN=12
# Extra candidates drawn at random from Cloudflare ranges, one per /24. Only ranges that answered
# from mainland China are listed: of 140 random addresses over all 15 published ranges (2026-09-24,
# Aliyun Shanghai / Tencent Beijing / a Shanghai campus line), these passed 10-60%; the other ranges
# passed 0-1 of 12, mostly SYN timeouts. Random passes from the datacenter lines were slow (0.7-2s
# median against 250-500ms for pool IPs), so this mainly widens coverage; history keeps the winners.
SAMPLE_CIDRS=104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,162.158.0.0/15,188.114.96.0/20,190.93.240.0/20
SAMPLE_N=40
# IPs tested at once; one IP's 12 rounds stay back to back.
PARALLEL=8
# Report every IP that passed, up to this many (the server keeps 64 per source and serves 6): it
# keeps the IPs good for all probers, so each list must reach past its own fastest few. At 16, a
# line with 42 IPs tied within 3ms cut its list almost at random and only one IP was common to all.
TOP_N=48
# IPv6 ranking (echprobe-report6.timer; only on a prober with a public IPv6 address). Candidates are
# the AAAA records of these domains; the report goes to the server under SOURCE6.
SOURCE6=aliyun-shanghai-v6
CANDIDATES6=cf.090227.xyz,cu.090227.xyz,ct.090227.xyz,skk.moe,yx.cloudflare.182682.xyz,cf.877774.xyz,cloudflare-ech.com,www.cloudflare.com
# Two solid IPs beat keeping a stale pool alive; below this nothing is reported.
MIN_N=2
# Must exceed the timer interval so the pool never lapses between runs.
TTL=4200
# Meta ECH key check: verdicts go to /admin/health. A rotated key stays active for META_TTL
# seconds (re-confirmed every run), so a day covers any prober outage without going stale.
HEALTH_URL=https://edge.1molchuan.top/admin/health
META_HOST=www.instagram.com
META_TTL=86400
# Self-check (echprobe-selfcheck.timer): hosts whose A/AAAA/HTTPS answers must let Chromium use ECH.
SELFCHECK_URL=https://edge.1molchuan.top/admin/selfcheck
SELFCHECK_HOSTS=x.com,abs.twimg.com,pbs.twimg.com,video.twimg.com,api.x.com,t.co,linux.do,www.instagram.com,static.cdninstagram.com,chatgpt.com,api.openai.com,grok.com
# Site check (echprobe-sitecheck.timer, on every prober): pages that need each site's ORIGIN, fetched
# through the pool. Pick small paths the site answers from its origin; a fast 403 challenge is fine.
# The unit defaults SITE_URLS to linux.do's /srv/status and /about.json.
SITE_URL=https://edge.1molchuan.top/admin/site
# QUIC+ECH check (echprobe-h3.timer, on every prober): a verdict covers the host and its subdomains.
# A host keeps h3 only while every prober passes it (at most 1 in 10 handshakes failing).
H3_URL=https://edge.1molchuan.top/admin/h3
H3_HOSTS=x.com,abs.twimg.com,pbs.twimg.com,video.twimg.com,linux.do,www.instagram.com,static.cdninstagram.com
H3_ROUNDS=10
# GitHub preferred-IP (echprobe-github.timer): candidates from community hosts files, verified per host
# from this line (cert-validated plain TLS, no ECH) and reported per host to /admin/github. Reachable
# mirrors from mainland China 2026-09-25: raw.hellogithub.com (GitHub520) and the ineo6 GitLab mirror.
GITHUB_URL=https://edge.1molchuan.top/admin/github
GITHUB_SOURCES=https://raw.hellogithub.com/hosts,https://gitlab.com/ineo6/hosts/-/raw/master/next-hosts
GITHUB_HOSTS=github.com,gist.github.com,api.github.com,codeload.github.com,raw.githubusercontent.com,objects.githubusercontent.com,avatars.githubusercontent.com,camo.githubusercontent.com,media.githubusercontent.com,user-images.githubusercontent.com,private-user-images.githubusercontent.com,cloud.githubusercontent.com,desktop.githubusercontent.com,favicons.githubusercontent.com,github.githubassets.com
